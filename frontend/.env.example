# ── Copy to .env and fill in. Vite exposes only VITE_-prefixed vars to the app. ──
# NOTE: everything here ships to the browser, so use ONLY public values:
# the Supabase anon key (safe with RLS) and the Razorpay test/live KEY ID.
# Never put service-role keys or Razorpay key SECRET here.

VITE_API_BASE_URL="http://localhost:8000"
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
VITE_RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
