# ── Copy to .env and fill in. NEVER commit the real .env. ──

# --- App ---
STUDIO_NAME="Your Studio Name"
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS="http://localhost:5173"
# IANA timezone used for all month/pro-rata math
TIMEZONE="Asia/Kolkata"
# Public URL of the student portal, used in WhatsApp/email reminder links
STUDENT_PORTAL_URL="http://localhost:5173"

# --- Supabase ---
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# Server-only. Full DB access — keep secret, never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Public anon/publishable key — used server-side for the username+password login
# grant. Safe to be public (same key the frontend uses).
SUPABASE_ANON_KEY="your-anon-publishable-key"
# Used to verify student JWTs (Supabase project JWT secret).
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# --- Admin (single hardcoded login) ---
ADMIN_EMAIL="admin@yourstudio.com"
ADMIN_PASSWORD="change-me-strong-password"
# Secret used to sign the admin session JWT (any long random string).
ADMIN_JWT_SECRET="generate-a-long-random-string"

# --- Razorpay ---
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
# Set when you configure the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# --- Email reminders (Resend) — leave blank to disable sending ---
RESEND_API_KEY=""
REMINDER_FROM_EMAIL="reminders@yourstudio.com"
